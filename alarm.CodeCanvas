		"Warn users about potential alarm failures when the app is manually killed.": {
			"name": "Warn users about potential alarm failures when the app is manually killed.",
			"simSteps": [
				{
					"simStepId": "208e10f8-9d92-407e-8e2c-b15578e3beb5",
					"diagramNodeId": "45f64667-f366-4ffa-8c7b-26d544f48473",
					"simStepLabel": "Configure Alarm in Flutter",
					"simStepDescription": "The user configures an alarm in the Flutter application, setting the `warningNotificationOnKill` property to `true` within the `AlarmSettings` object. This is recommended for iOS to warn users that killing the app will prevent alarms from firing.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "lib/model/alarm_settings.dart",
						"startLine": "138",
						"endLine": "142",
						"relevantVariables": [
							"warningNotificationOnKill"
						]
					},
					"inputDataExample": "{\n  \"id\": 42,\n  \"dateTime\": \"2024-09-01T07:30:00\",\n  \"assetAudioPath\": \"assets/marimba.mp3\",\n  \"enableWarningOnKill\": true\n}",
					"outputDataExample": "{\n  \"id\": 42,\n  \"dateTime\": \"2024-09-01T07:30:00.000Z\",\n  \"assetAudioPath\": \"assets/marimba.mp3\",\n  \"loopAudio\": true,\n  \"vibrate\": true,\n  \"warningNotificationOnKill\": true,\n  \"androidFullScreenIntent\": true,\n  \"allowAlarmOverlap\": false,\n  \"iOSBackgroundAudio\": true,\n  \"androidStopAlarmOnTermination\": true,\n  \"notificationSettings\": {\n    \"title\": \"Alarm\",\n    \"body\": \"Wake up!\"\n  },\n  \"volumeSettings\": {\n    \"volume\": 0.8\n  }\n}"
				},
				{
