					"diagramNodeId": "26a93136-a396-44f4-bc5e-41065b725989",
					"simStepLabel": "Transmit Alarm Settings to Native iOS",
					"simStepDescription": "When `Alarm.set()` is called, the `AlarmSettings` object is serialized into an `AlarmSettingsWire` object and transmitted from the Dart layer to the native iOS layer via a Pigeon message channel.",
					"isEdge": 1,
					"sourceCodeMapping": {
