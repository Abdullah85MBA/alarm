		"4c4ea06d-02fc-4382-b868-bd0989a38626": {
			"path": "4c4ea06d-02fc-4382-b868-bd0989a38626",
			"cellName": "Android Flow: Set Alarm from Flutter App - edit_alarm.dart:L135-138",
			"cellId": "4c4ea06d-02fc-4382-b868-bd0989a38626",
			"visible": true,
			"parentCellId": "e58b3c99-caa6-4a71-8e7f-4f4d1dc8cb41"
		},
		"example/lib/screens/edit_alarm.dart-simstep-b707dd81-a44a-4ce5-9d13-056f18060299": {
			"path": "example/lib/screens/edit_alarm.dart-simstep-b707dd81-a44a-4ce5-9d13-056f18060299",
			"fileName": "edit_alarm.dart",
			"wiki": "The user configures alarm settings in the Flutter application and calls `Alarm.set()` to schedule it. This initiates the process of sending alarm data to the native Android platform.",
			"cellName": "Android Flow: Set Alarm from Flutter App - edit_alarm.dart:L135-138",
			"cellId": "4c4ea06d-02fc-4382-b868-bd0989a38626",
