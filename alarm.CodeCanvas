		"android/src/main/kotlin/com/gdelataillade/alarm/services/AudioService.kt-simstep-f9108af7-c0c8-466f-a5b4-c66a3023efd2": {
			"path": "android/src/main/kotlin/com/gdelataillade/alarm/services/AudioService.kt-simstep-f9108af7-c0c8-466f-a5b4-c66a3023efd2",
			"fileName": "AudioService.kt",
			"wiki": "The `AudioService` creates a `MediaPlayer` instance for the alarm sound. If a `fadeDuration` is provided, it schedules a `Timer` that repeatedly executes a task. This task incrementally increases the media player's volume from 0.0 to 1.0 over the specified duration, creating a smooth fade-in effect.",
			"cellName": "Android Flow: Execute Volume Fade-In - AudioService.kt:L113-136",
			"cellId": "82b13292-fb81-4901-a8ab-d6e4e5fcf624",
