		"lib/alarm.dart-simstep-1b18d469-2ea4-426e-aef6-d0f24ebaed58": {
			"path": "lib/alarm.dart-simstep-1b18d469-2ea4-426e-aef6-d0f24ebaed58",
			"fileName": "alarm.dart",
			"wiki": "After the native call returns successfully, the `Alarm.stop` method proceeds to update the streams. It removes the alarm from the `_ringing` BehaviorSubject, which will in turn notify all listeners.",
