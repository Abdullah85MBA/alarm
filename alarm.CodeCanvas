				},
				{
					"simStepId": "f819d130-95f7-47e0-8390-a5bf0236db52",
					"diagramNodeId": "bd9007f1-1cb7-43ac-8862-65756bbeb5db",
					"simStepLabel": "Dart: Invoke Native API via BaseAlarm",
					"simStepDescription": "The `stopAll` method in the `BaseAlarm` class is called. It first stops any Dart-side timers via `PlatformTimers.stopAll()` and then uses the Pigeon-generated `api.stopAll()` method to send a request to the native platform code.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "lib/src/base_alarm.dart",
						"startLine": "65",
						"endLine": "68",
						"relevantVariables": [
							"stopAll",
							"PlatformTimers.stopAll",
							"api.stopAll"
						]
					},
					"inputDataExample": "null",
					"outputDataExample": "{ \"native_call\": \"stopAll\" }"
				},
				{
					"simStepId": "a53181d0-8a86-40d1-8298-f229bab94926",
					"diagramNodeId": "d40e4ae5-b044-4a83-97b6-44923d7521ed",
					"simStepLabel": "Platform Channel: Transmit stopAll Request",
					"simStepDescription": "The Pigeon library serializes the `stopAll` method call and sends it over a `BasicMessageChannel` to the corresponding native (Kotlin/Swift) side for handling.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "lib/src/generated/platform_bindings.g.dart",
						"startLine": "453",
						"endLine": "461",
						"relevantVariables": [
							"AlarmApi",
							"stopAll",
							"BasicMessageChannel"
						]
					},
					"inputDataExample": "{ \"channel\": \"dev.flutter.pigeon.alarm.AlarmApi.stopAll\", \"message\": null }",
					"outputDataExample": "{ \"channel\": \"dev.flutter.pigeon.alarm.AlarmApi.stopAll\", \"message\": null }"
				},
				{
					"simStepId": "cef62f20-ed51-4353-a447-6b01503cb593",
					"diagramNodeId": "38b1d110-90c7-41bf-89f5-b2db114c1faa",
					"simStepLabel": "Native: Process stopAll Request",
					"simStepDescription": "The native platform code receives the `stopAll` call via the Pigeon message handler.\nOn Android: The `AlarmApiImpl.kt` implementation iterates through all saved alarms and calls `stopAlarm` for each one. This cancels the associated `PendingIntent` with the system `AlarmManager`.\nOn iOS: The `AlarmApiImpl.swift` implementation calls `AlarmManager.stopAll()`, which cancels all scheduled notifications, stops any active ringtone via `AlarmRingManager`, and invalidates all internal `Timer` objects.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "android/src/main/kotlin/com/gdelataillade/alarm/api/AlarmApiImpl.kt",
						"startLine": "83",
						"endLine": "90",
						"relevantVariables": [
							"stopAll",
							"AlarmStorage",
							"stopAlarm"
						]
					},
					"inputDataExample": "{ \"channel\": \"dev.flutter.pigeon.alarm.AlarmApi.stopAll\", \"message\": null }",
					"outputDataExample": "{ \"result\": \"success\" }"
				},
				{
					"simStepId": "a0f78de9-0cf1-4276-80cf-c33d4a85e87f",
					"diagramNodeId": "1a71655b-7af4-41d7-b274-6f3126314f2e",
					"simStepLabel": "Platform Channel: Return Result to Dart",
					"simStepDescription": "After the native code successfully stops all alarms, it sends a success result back to the Dart side over the platform channel.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "android/src/main/kotlin/com/gdelataillade/alarm/generated/FlutterBindings.g.kt",
						"startLine": "403",
						"endLine": "408",
						"relevantVariables": [
							"api.stopAll",
							"reply.reply"
						]
					},
					"inputDataExample": "{ \"result\": \"success\" }",
					"outputDataExample": "{ \"result\": \"success\" }"
				},
				{
					"simStepId": "3017a032-9e54-41d5-b09b-64c741f25dc1",
					"diagramNodeId": "10d8588d-3ac2-457a-9aa0-30eb4484833c",
					"simStepLabel": "Dart: Clear Alarms from Persistent Storage",
					"simStepDescription": "Once the native execution is complete, control returns to the `Alarm.stopAll` method in Dart. It then calls `AlarmStorage.unsaveAll()` to remove the data for all alarms from the device's persistent storage (SharedPreferences).",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "lib/alarm.dart",
						"startLine": "184",
						"endLine": "184",
						"relevantVariables": [
							"AlarmStorage.unsaveAll"
						]
					},
					"inputDataExample": "{ \"result\": \"success\" }",
					"outputDataExample": "{ \"storage_cleared\": true }"
				},
				{
					"simStepId": "6add8d17-763e-49e4-92c3-8c8401dbcfc5",
					"diagramNodeId": "c1358cb9-fbcc-43ea-9053-b9338b52d833",
					"simStepLabel": "Data Flow: Update Alarm Streams",
					"simStepDescription": "The `Alarm.stopAll` method iterates through the list of alarms it originally fetched and adds each alarm's ID to the `updateStream` to notify listeners that these alarms have been removed. This stream is deprecated but still functional.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "lib/alarm.dart",
						"startLine": "186",
						"endLine": "188",
						"relevantVariables": [
							"updateStream",
							"alarm.id"
						]
					},
					"inputDataExample": "{ \"stoppedAlarmId\": 42 }",
					"outputDataExample": "{ \"stoppedAlarmId\": 42 }"
				},
				{
					"simStepId": "706e62cb-4bbd-4037-96ed-17a576c6aef3",
					"diagramNodeId": "3aa05a5a-8678-4b93-91af-1c44630a71f0",
					"simStepLabel": "UI Update: Refresh Alarm List",
					"simStepDescription": "The home screen, which listens to the `Alarm.scheduled` stream, receives the updated (now empty) set of alarms. The `StreamBuilder` widget rebuilds the UI to show that there are no more alarms scheduled.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "example/lib/screens/home.dart",
						"startLine": "91",
						"endLine": "137",
						"relevantVariables": [
