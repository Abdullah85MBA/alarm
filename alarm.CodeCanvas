		"ios/Classes/services/AlarmManager.swift-simstep-298d9e58-9954-4542-bb6d-854916239636": {
			"path": "ios/Classes/services/AlarmManager.swift-simstep-298d9e58-9954-4542-bb6d-854916239636",
			"fileName": "AlarmManager.swift",
			"wiki": "The `AlarmManager` stores the alarm configuration. Instead of using a system-level service like Android, it schedules an in-app `Timer` to fire at the exact time the alarm is supposed to ring. To keep the app alive in the background, it may employ techniques like playing silent audio.",
			"cellName": "iOS Flow: Schedule In-App Timer - AlarmManager.swift:L16-51",
			"cellId": "1cdeda2c-dbdb-40ce-bf1c-197775234d74",
			"visible": true,
			"startLine": 16,
			"endLine": 51,
			"parentCellId": "6ccc5d2b-07de-40a8-8fea-894d251e9d5e",
			"parentPath": "ios/Classes/services/AlarmManager.swift",
			"simSteps": [
				{
					"simulationKey": "Set and trigger a reliable, persistent alarm across platforms, even when the app is killed or the device is rebooted.",
					"simStepId": "298d9e58-9954-4542-bb6d-854916239636"
				}
			]
		},
		"d6e86cfe-7c44-4c43-82d3-e1dbfc721a83": {
			"path": "d6e86cfe-7c44-4c43-82d3-e1dbfc721a83",
			"cellName": "iOS Flow: Timer Callback Triggers Ringing - AlarmManager.swift:L130-137",
			"cellId": "d6e86cfe-7c44-4c43-82d3-e1dbfc721a83",
			"visible": true,
			"parentCellId": "6ccc5d2b-07de-40a8-8fea-894d251e9d5e"
		},
		"ios/Classes/services/AlarmManager.swift-simstep-e4eb26ea-33a1-40e0-8d27-53bb3d9cf551": {
			"path": "ios/Classes/services/AlarmManager.swift-simstep-e4eb26ea-33a1-40e0-8d27-53bb3d9cf551",
			"fileName": "AlarmManager.swift",
			"wiki": "The `alarmTimerTrigerred` function is executed. It extracts the alarm ID from the timer's user info and calls the `ringAlarm` method to start the actual ringing process.",
			"cellName": "iOS Flow: Timer Callback Triggers Ringing - AlarmManager.swift:L130-137",
			"cellId": "d6e86cfe-7c44-4c43-82d3-e1dbfc721a83",
