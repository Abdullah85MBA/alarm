			"parentPath": "example/lib/screens/edit_alarm.dart",
			"simSteps": [
				{
					"simulationKey": "Set and trigger a reliable, persistent alarm across platforms, even when the app is killed or the device is rebooted.",
					"simStepId": "b707dd81-a44a-4ce5-9d13-056f18060299"
				}
			]
		},
		"a62146fd-7499-4086-af5a-cc0a188453e3": {
			"path": "a62146fd-7499-4086-af5a-cc0a188453e3",
			"cellName": "Android Flow: Receive and Schedule Alarm with AlarmManager - AlarmApiImpl.kt:L162-178",
			"cellId": "a62146fd-7499-4086-af5a-cc0a188453e3",
			"visible": true,
			"parentCellId": "432e2862-3019-4964-9863-443e9460c5f0"
		},
		"android/src/main/kotlin/com/gdelataillade/alarm/api/AlarmApiImpl.kt-simstep-31a19db7-a14e-4c49-bbbf-19af4b5cff9a": {
			"path": "android/src/main/kotlin/com/gdelataillade/alarm/api/AlarmApiImpl.kt-simstep-31a19db7-a14e-4c49-bbbf-19af4b5cff9a",
			"fileName": "AlarmApiImpl.kt",
			"wiki": "The native Kotlin code in `AlarmApiImpl` receives the alarm settings. It creates a `PendingIntent` that points to `AlarmReceiver` and uses the system's `AlarmManager` to schedule this intent to be broadcast at the specified date and time, even if the app is closed.",
			"cellName": "Android Flow: Receive and Schedule Alarm with AlarmManager - AlarmApiImpl.kt:L162-178",
			"cellId": "a62146fd-7499-4086-af5a-cc0a188453e3",
			"visible": true,
			"startLine": 162,
			"endLine": 178,
			"parentCellId": "432e2862-3019-4964-9863-443e9460c5f0",
			"parentPath": "android/src/main/kotlin/com/gdelataillade/alarm/api/AlarmApiImpl.kt",
			"simSteps": [
				{
					"simulationKey": "Set and trigger a reliable, persistent alarm across platforms, even when the app is killed or the device is rebooted.",
					"simStepId": "31a19db7-a14e-4c49-bbbf-19af4b5cff9a"
				}
			]
		},
		"97179b33-4a8f-40ff-9e8d-18b77a3b07ea": {
			"path": "97179b33-4a8f-40ff-9e8d-18b77a3b07ea",
			"cellName": "Android Flow: AlarmReceiver Starts AlarmService - AlarmReceiver.kt:L29-47",
			"cellId": "97179b33-4a8f-40ff-9e8d-18b77a3b07ea",
			"visible": true,
			"parentCellId": "4c2f7b54-ae3c-41d7-bd81-3469c3f4a1b9"
		},
		"android/src/main/kotlin/com/gdelataillade/alarm/alarm/AlarmReceiver.kt-simstep-acd12a0b-22dd-4be9-b06e-c0f1f405d8a3": {
			"path": "android/src/main/kotlin/com/gdelataillade/alarm/alarm/AlarmReceiver.kt-simstep-acd12a0b-22dd-4be9-b06e-c0f1f405d8a3",
			"fileName": "AlarmReceiver.kt",
			"wiki": "The `AlarmReceiver` (a `BroadcastReceiver`) receives the intent from the `AlarmManager`. Its primary role is to immediately start the `AlarmService` as a foreground service, passing along all the alarm details. This ensures the alarm can ring even if the app is not running.",
			"cellName": "Android Flow: AlarmReceiver Starts AlarmService - AlarmReceiver.kt:L29-47",
			"cellId": "97179b33-4a8f-40ff-9e8d-18b77a3b07ea",
			"visible": true,
			"startLine": 29,
			"endLine": 47,
			"parentCellId": "4c2f7b54-ae3c-41d7-bd81-3469c3f4a1b9",
			"parentPath": "android/src/main/kotlin/com/gdelataillade/alarm/alarm/AlarmReceiver.kt",
			"simSteps": [
				{
					"simulationKey": "Set and trigger a reliable, persistent alarm across platforms, even when the app is killed or the device is rebooted.",
					"simStepId": "acd12a0b-22dd-4be9-b06e-c0f1f405d8a3"
				}
			]
		},
		"cd5493e6-adee-4a6d-a78a-64e74d8f5f61": {
			"path": "cd5493e6-adee-4a6d-a78a-64e74d8f5f61",
			"cellName": "Android Flow: AlarmService Handles Ringing - AlarmService.kt:L52",
			"cellId": "cd5493e6-adee-4a6d-a78a-64e74d8f5f61",
			"visible": true,
			"parentCellId": "00830dbd-8e42-4240-9477-4ae11f3e13e1"
		},
		"android/src/main/kotlin/com/gdelataillade/alarm/alarm/AlarmService.kt-simstep-4925a5da-de97-4866-b2e5-f80e68ed2282": {
			"path": "android/src/main/kotlin/com/gdelataillade/alarm/alarm/AlarmService.kt-simstep-4925a5da-de97-4866-b2e5-f80e68ed2282",
			"fileName": "AlarmService.kt",
			"wiki": "The `AlarmService` runs as a foreground service, making it a high-priority process. In its `onStartCommand` method, it manages the alarm's lifecycle: showing a full-screen notification, playing audio via `AudioService`, and triggering vibrations via `VibrationService`.",
			"cellName": "Android Flow: AlarmService Handles Ringing - AlarmService.kt:L52",
			"cellId": "cd5493e6-adee-4a6d-a78a-64e74d8f5f61",
			"visible": true,
			"startLine": 52,
			"endLine": 52,
			"parentCellId": "00830dbd-8e42-4240-9477-4ae11f3e13e1",
			"parentPath": "android/src/main/kotlin/com/gdelataillade/alarm/alarm/AlarmService.kt",
			"simSteps": [
				{
					"simulationKey": "Set and trigger a reliable, persistent alarm across platforms, even when the app is killed or the device is rebooted.",
					"simStepId": "4925a5da-de97-4866-b2e5-f80e68ed2282"
				}
			]
		},
		"5c72dbe0-c62d-4882-b9b9-5ccee9d9804e": {
			"path": "5c72dbe0-c62d-4882-b9b9-5ccee9d9804e",
			"cellName": "Android Flow: Flutter App Receives Ringing Event - ring.dart:L23-28",
			"cellId": "5c72dbe0-c62d-4882-b9b9-5ccee9d9804e",
			"visible": true,
			"parentCellId": "f7c83855-a965-4990-ae86-966f24de5165"
		},
		"example/lib/screens/ring.dart-simstep-e90e7927-d313-4e29-9aef-ce8151308e9a": {
			"path": "example/lib/screens/ring.dart-simstep-e90e7927-d313-4e29-9aef-ce8151308e9a",
			"fileName": "ring.dart",
			"wiki": "The Flutter part of the plugin listens for events from the native side. When the 'ringing' event is received, it's added to the `Alarm.ringing` stream. A listener in the app's UI code (like the `ring.dart` screen) can then react, for example, by navigating to a dedicated ringing screen.",
			"cellName": "Android Flow: Flutter App Receives Ringing Event - ring.dart:L23-28",
			"cellId": "5c72dbe0-c62d-4882-b9b9-5ccee9d9804e",
			"visible": true,
			"startLine": 23,
			"endLine": 28,
			"parentCellId": "f7c83855-a965-4990-ae86-966f24de5165",
			"parentPath": "example/lib/screens/ring.dart",
			"simSteps": [
