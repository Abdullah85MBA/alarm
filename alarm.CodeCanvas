		},
		"android/src/main/kotlin/com/gdelataillade/alarm/alarm/BootReceiver.kt-simstep-84db4488-f48c-49c9-99f1-7da2deafe6f7": {
			"path": "android/src/main/kotlin/com/gdelataillade/alarm/alarm/BootReceiver.kt-simstep-84db4488-f48c-49c9-99f1-7da2deafe6f7",
			"fileName": "BootReceiver.kt",
			"wiki": "When the Android device is rebooted, the OS broadcasts the `ACTION_BOOT_COMPLETED` intent. A `BroadcastReceiver` in the app, the `BootReceiver`, is registered to listen for this specific intent.",
			"cellName": "Reboot Flow (Android): System Boot Completed - BootReceiver.kt:L1",
			"cellId": "979b2b5d-7fb1-41e3-a07f-f8f08c00b6e9",
			"visible": true,
			"startLine": 1,
			"endLine": 1,
			"parentCellId": "ac825a83-bc6b-41de-ae8d-d2fc5d3dcb98",
			"parentPath": "android/src/main/kotlin/com/gdelataillade/alarm/alarm/BootReceiver.kt",
			"simSteps": [
				{
					"simulationKey": "Set and trigger a reliable, persistent alarm across platforms, even when the app is killed or the device is rebooted.",
					"simStepId": "84db4488-f48c-49c9-99f1-7da2deafe6f7"
				}
			]
		},
		"a4e8f8d3-2532-4b3e-973f-1d5104daec68": {
			"path": "a4e8f8d3-2532-4b3e-973f-1d5104daec68",
			"cellName": "Reboot Flow (Android): Reschedule Stored Alarms - AlarmApiImpl.kt:L162-178",
			"cellId": "a4e8f8d3-2532-4b3e-973f-1d5104daec68",
			"visible": true,
			"parentCellId": "432e2862-3019-4964-9863-443e9460c5f0"
		},
		"android/src/main/kotlin/com/gdelataillade/alarm/api/AlarmApiImpl.kt-simstep-2869becc-d190-4857-8e7c-618dbb6e2d1d": {
			"path": "android/src/main/kotlin/com/gdelataillade/alarm/api/AlarmApiImpl.kt-simstep-2869becc-d190-4857-8e7c-618dbb6e2d1d",
			"fileName": "AlarmApiImpl.kt",
			"wiki": "The `BootReceiver`'s `onReceive` method is executed. It accesses persistent storage (via `AlarmStorage`) to retrieve all alarms that were set before the reboot. It then iterates through them and reschedules each one using the same `AlarmManager` logic from the main flow.",
			"cellName": "Reboot Flow (Android): Reschedule Stored Alarms - AlarmApiImpl.kt:L162-178",
			"cellId": "a4e8f8d3-2532-4b3e-973f-1d5104daec68",
			"visible": true,
			"startLine": 162,
