	"simulations": {
		"Set and trigger a reliable, persistent alarm across platforms, even when the app is killed or the device is rebooted.": {
			"name": "Set and trigger a reliable, persistent alarm across platforms, even when the app is killed or the device is rebooted.",
			"simSteps": [
				{
					"simStepId": "b707dd81-a44a-4ce5-9d13-056f18060299",
					"diagramNodeId": "4c4ea06d-02fc-4382-b868-bd0989a38626",
					"simStepLabel": "Android Flow: Set Alarm from Flutter App",
					"simStepDescription": "The user configures alarm settings in the Flutter application and calls `Alarm.set()` to schedule it. This initiates the process of sending alarm data to the native Android platform.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "example/lib/screens/edit_alarm.dart",
						"startLine": "135",
						"endLine": "138",
						"relevantVariables": [
							"Alarm.set",
							"buildAlarmSettings"
						]
					},
					"inputDataExample": "{\n  \"alarmSettings\": {\n    \"id\": 42,\n    \"dateTime\": \"2024-07-23T08:00:00.000Z\",\n    \"assetAudioPath\": \"assets/marimba.mp3\",\n    \"loopAudio\": true,\n    \"vibrate\": true,\n    \"volumeSettings\": {\n      \"volume\": 0.8,\n      \"fadeDuration\": 5000\n    },\n    \"notificationSettings\": {\n      \"title\": \"Morning Alarm\",\n      \"body\": \"Time to wake up!\",\n      \"stopButtonText\": \"Stop\"\n    }\n  }\n}",
					"outputDataExample": "{\n  \"alarmSettingsWire\": {\n    \"id\": 42,\n    \"millisecondsSinceEpoch\": 1721721600000,\n    \"assetAudioPath\": \"assets/marimba.mp3\",\n    \"loopAudio\": true,\n    \"vibrate\": true,\n    \"volumeSettings\": {\n      \"volume\": 0.8,\n      \"fadeDuration\": 5000\n    },\n    \"notificationSettings\": {\n      \"title\": \"Morning Alarm\",\n      \"body\": \"Time to wake up!\",\n      \"stopButtonText\": \"Stop\"\n    }\n  }\n}"
				},
				{
					"simStepId": "363128cb-e28e-41c3-a4d7-afcbe2bcbc4c",
					"diagramNodeId": "76bd324d-d39e-4859-a866-2287829ba3c3",
					"simStepLabel": "Android Flow: Transmit Alarm Settings to Native Code",
					"simStepDescription": "The `Alarm.set` method in Dart uses a Pigeon channel to serialize the `AlarmSettings` object and send it to the native Android (Kotlin) implementation for processing.",
					"isEdge": 1,
