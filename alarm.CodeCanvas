							"snapshot"
						]
					},
					"inputDataExample": "{ \"scheduled_alarms\": [] }",
					"outputDataExample": "{ \"ui_state\": \"no_alarms\" }"
				}
			],
			"description": "<ul><li>Offers a convenience method, <code>Alarm</li><li>stopAll()</code>, to cancel every single scheduled alarm</li><li>The example application includes a prominent STOP ALL button for users to quickly disable all their alarms</li><li>This is a quality-of-life feature for users managing many alarms</li></ul>",
