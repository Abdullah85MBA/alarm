		"android/src/main/kotlin/com/gdelataillade/alarm/api/AlarmApiImpl.kt-simstep-88271017-efad-43f9-99b2-4a877f66d4c6": {
			"path": "android/src/main/kotlin/com/gdelataillade/alarm/api/AlarmApiImpl.kt-simstep-88271017-efad-43f9-99b2-4a877f66d4c6",
			"fileName": "AlarmApiImpl.kt",
			"wiki": "On Android, the `AlarmApiImpl` receives the `stopAlarm` call. It creates an `Intent` with a 'STOP_ALARM' action and sends it to the running `AlarmService`, causing it to stop the audio, remove the notification, and terminate itself. It then returns a success result to Flutter.",
			"cellName": "Alarm Stopping: Native Code Stops Service - AlarmApiImpl.kt:L39-44",
			"cellId": "b9f022cf-8234-4948-beab-49f4560330a9",
			"visible": true,
			"startLine": 39,
			"endLine": 44,
			"parentCellId": "432e2862-3019-4964-9863-443e9460c5f0",
			"parentPath": "android/src/main/kotlin/com/gdelataillade/alarm/api/AlarmApiImpl.kt",
			"simSteps": [
				{
					"simulationKey": "Allow the app to react in real-time to alarm events like ringing or being stopped.",
					"simStepId": "88271017-efad-43f9-99b2-4a877f66d4c6"
				}
			]
		},
