					"simStepId": "f819d130-95f7-47e0-8390-a5bf0236db52"
				}
			]
		},
		"38b1d110-90c7-41bf-89f5-b2db114c1faa": {
			"path": "38b1d110-90c7-41bf-89f5-b2db114c1faa",
			"cellName": "Native: Process stopAll Request - AlarmApiImpl.kt:L83-90",
			"cellId": "38b1d110-90c7-41bf-89f5-b2db114c1faa",
			"visible": true,
			"parentCellId": "432e2862-3019-4964-9863-443e9460c5f0"
		},
		"android/src/main/kotlin/com/gdelataillade/alarm/api/AlarmApiImpl.kt-simstep-cef62f20-ed51-4353-a447-6b01503cb593": {
			"path": "android/src/main/kotlin/com/gdelataillade/alarm/api/AlarmApiImpl.kt-simstep-cef62f20-ed51-4353-a447-6b01503cb593",
			"fileName": "AlarmApiImpl.kt",
			"wiki": "The native platform code receives the `stopAll` call via the Pigeon message handler.\nOn Android: The `AlarmApiImpl.kt` implementation iterates through all saved alarms and calls `stopAlarm` for each one. This cancels the associated `PendingIntent` with the system `AlarmManager`.\nOn iOS: The `AlarmApiImpl.swift` implementation calls `AlarmManager.stopAll()`, which cancels all scheduled notifications, stops any active ringtone via `AlarmRingManager`, and invalidates all internal `Timer` objects.",
			"cellName": "Native: Process stopAll Request - AlarmApiImpl.kt:L83-90",
			"cellId": "38b1d110-90c7-41bf-89f5-b2db114c1faa",
			"visible": true,
			"startLine": 83,
			"endLine": 90,
			"parentCellId": "432e2862-3019-4964-9863-443e9460c5f0",
			"parentPath": "android/src/main/kotlin/com/gdelataillade/alarm/api/AlarmApiImpl.kt",
			"simSteps": [
				{
					"simulationKey": "Provide a master control to stop all scheduled alarms at once.",
					"simStepId": "cef62f20-ed51-4353-a447-6b01503cb593"
				}
			]
		},
		"10d8588d-3ac2-457a-9aa0-30eb4484833c": {
			"path": "10d8588d-3ac2-457a-9aa0-30eb4484833c",
			"cellName": "Dart: Clear Alarms from Persistent Storage - alarm.dart:L184",
			"cellId": "10d8588d-3ac2-457a-9aa0-30eb4484833c",
			"visible": true,
			"parentCellId": "4e0798c7-e641-49c0-a5a6-1e52a1aade60"
		},
		"lib/alarm.dart-simstep-3017a032-9e54-41d5-b09b-64c741f25dc1": {
			"path": "lib/alarm.dart-simstep-3017a032-9e54-41d5-b09b-64c741f25dc1",
			"fileName": "alarm.dart",
			"wiki": "Once the native execution is complete, control returns to the `Alarm.stopAll` method in Dart. It then calls `AlarmStorage.unsaveAll()` to remove the data for all alarms from the device's persistent storage (SharedPreferences).",
			"cellName": "Dart: Clear Alarms from Persistent Storage - alarm.dart:L184",
			"cellId": "10d8588d-3ac2-457a-9aa0-30eb4484833c",
			"visible": true,
			"startLine": 184,
			"endLine": 184,
			"parentCellId": "4e0798c7-e641-49c0-a5a6-1e52a1aade60",
			"parentPath": "lib/alarm.dart",
			"simSteps": [
				{
					"simulationKey": "Provide a master control to stop all scheduled alarms at once.",
					"simStepId": "3017a032-9e54-41d5-b09b-64c741f25dc1"
				}
			]
		},
