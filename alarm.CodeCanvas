		"example/lib/screens/edit_alarm.dart-simstep-805bf1ad-91eb-4fd3-9b58-ec53efad834e": {
			"path": "example/lib/screens/edit_alarm.dart-simstep-805bf1ad-91eb-4fd3-9b58-ec53efad834e",
			"fileName": "edit_alarm.dart",
			"wiki": "In the Flutter UI, the user sets the alarm time and configures volume settings. This example demonstrates setting up a gradual fade-in over 15 seconds, with the final volume capped at 80%. These settings are used to construct an `AlarmSettings` object.",
			"cellName": "Configure Volume Settings - edit_alarm.dart:L95-114",
			"cellId": "fd3423f8-a7b7-46e9-9f93-d87ee85b51f5",
			"visible": true,
			"startLine": 95,
			"endLine": 114,
			"parentCellId": "e58b3c99-caa6-4a71-8e7f-4f4d1dc8cb41",
			"parentPath": "example/lib/screens/edit_alarm.dart",
			"simSteps": [
				{
