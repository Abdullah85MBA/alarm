					"outputDataExample": "{\n  \"observerRegistered\": true,\n  \"notificationName\": \"UIApplication.willTerminateNotification\",\n  \"callbackSelector\": \"appWillTerminate\"\n}"
				},
				{
					"simStepId": "2dcf9fce-9636-4a6c-9e74-c3b16d747dc8",
					"diagramNodeId": "3b4d0a58-f168-4e92-9ed0-130b22484f3e",
					"simStepLabel": "System Broadcasts Termination Event",
					"simStepDescription": "When the user or the OS forcefully terminates the application, the iOS system broadcasts the `UIApplication.willTerminateNotification`. This event is caught by the observer registered in the previous step.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "ios/Classes/services/AppTerminateManager.swift",
						"startLine": "28",
						"endLine": "28",
						"relevantVariables": [
							"name: UIApplication.willTerminateNotification",
							"selector: #selector(self.appWillTerminate(notification:))"
						]
					},
					"inputDataExample": "{\n  \"name\": \"UIApplicationWillTerminateNotification\",\n  \"object\": \"<UIApplication: ...>\",\n  \"userInfo\": null\n}",
					"outputDataExample": "{\n  \"name\": \"UIApplicationWillTerminateNotification\",\n  \"object\": \"<UIApplication: ...>\",\n  \"userInfo\": null\n}"
				},
				{
					"simStepId": "89cfe88d-6df3-4f69-8383-60758ffd6af7",
					"diagramNodeId": "1b34c09d-41b4-4ae6-84b4-c3203f8e11b0",
					"simStepLabel": "Handle App Termination Event",
					"simStepDescription": "The `appWillTerminate` method in `AppTerminateManager` is executed in response to the system notification. It creates a task to call the `sendWarningNotification` function, ensuring the warning is sent before the app fully terminates.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "ios/Classes/services/AppTerminateManager.swift",
						"startLine": "47",
						"endLine": "52",
						"relevantVariables": [
							"appWillTerminate(notification:)",
							"sendWarningNotification()"
						]
					},
					"inputDataExample": "{\n  \"name\": \"UIApplicationWillTerminateNotification\",\n  \"object\": \"<UIApplication: ...>\",\n  \"userInfo\": null\n}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "48910092-ba7c-4cf8-b517-243cde28041b",
					"diagramNodeId": "120a51cf-fc73-40f1-834d-64a7fd33e604",
					"simStepLabel": "Trigger Warning Notification",
					"simStepDescription": "The `appWillTerminate` method asynchronously calls the `sendWarningNotification` function. This call transfers the responsibility of constructing and scheduling the actual user-facing notification.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "ios/Classes/services/AppTerminateManager.swift",
						"startLine": "50",
						"endLine": "50",
						"relevantVariables": [
							"await self.sendWarningNotification()"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "7caf5638-3c45-4045-aac7-31b4c6235c9b",
					"diagramNodeId": "89644ff7-ce01-4dc5-8580-42708cc900c7",
					"simStepLabel": "Schedule Warning Notification with OS",
					"simStepDescription": "The `sendWarningNotification` function assembles the notification's title and body (using defaults if not customized) and then calls the `NotificationManager` to schedule a local notification with the iOS UserNotifications framework. This notification informs the user that their alarms may not ring because the app was closed.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "ios/Classes/services/AppTerminateManager.swift",
						"startLine": "54",
						"endLine": "58",
						"relevantVariables": [
							"sendWarningNotification()",
							"notificationTitleOnKill",
