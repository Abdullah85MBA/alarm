		"45f64667-f366-4ffa-8c7b-26d544f48473": {
			"path": "45f64667-f366-4ffa-8c7b-26d544f48473",
			"cellName": "Configure Alarm in Flutter - alarm_settings.dart:L138-142",
			"cellId": "45f64667-f366-4ffa-8c7b-26d544f48473",
			"visible": true,
			"parentCellId": "1fe8a8d5-9186-47a7-82e4-98882f8df855"
		},
		"lib/model/alarm_settings.dart-simstep-208e10f8-9d92-407e-8e2c-b15578e3beb5": {
			"path": "lib/model/alarm_settings.dart-simstep-208e10f8-9d92-407e-8e2c-b15578e3beb5",
			"fileName": "alarm_settings.dart",
			"wiki": "The user configures an alarm in the Flutter application, setting the `warningNotificationOnKill` property to `true` within the `AlarmSettings` object. This is recommended for iOS to warn users that killing the app will prevent alarms from firing.",
			"cellName": "Configure Alarm in Flutter - alarm_settings.dart:L138-142",
			"cellId": "45f64667-f366-4ffa-8c7b-26d544f48473",
			"visible": true,
			"startLine": 138,
			"endLine": 142,
			"parentCellId": "1fe8a8d5-9186-47a7-82e4-98882f8df855",
			"parentPath": "lib/model/alarm_settings.dart",
			"simSteps": [
				{
					"simulationKey": "Warn users about potential alarm failures when the app is manually killed.",
					"simStepId": "208e10f8-9d92-407e-8e2c-b15578e3beb5"
				}
			]
		},
		"bb829b54-5dbe-40e5-b7d7-b5880b0d414e": {
			"path": "bb829b54-5dbe-40e5-b7d7-b5880b0d414e",
			"cellName": "Start App Termination Monitoring - AlarmManager.swift:L232-234",
			"cellId": "bb829b54-5dbe-40e5-b7d7-b5880b0d414e",
			"visible": true,
			"parentCellId": "6ccc5d2b-07de-40a8-8fea-894d251e9d5e"
		},
		"ios/Classes/services/AlarmManager.swift-simstep-727dfc15-97bd-4056-a1a8-c04394522595": {
			"path": "ios/Classes/services/AlarmManager.swift-simstep-727dfc15-97bd-4056-a1a8-c04394522595",
			"fileName": "AlarmManager.swift",
			"wiki": "The native `AlarmManager` receives the alarm settings. Its `updateState` method checks if any scheduled alarm has `warningNotificationOnKill` enabled. If so, it calls `AppTerminateManager` to start monitoring for app termination events.",
			"cellName": "Start App Termination Monitoring - AlarmManager.swift:L232-234",
			"cellId": "bb829b54-5dbe-40e5-b7d7-b5880b0d414e",
			"visible": true,
			"startLine": 232,
			"endLine": 234,
			"parentCellId": "6ccc5d2b-07de-40a8-8fea-894d251e9d5e",
			"parentPath": "ios/Classes/services/AlarmManager.swift",
			"simSteps": [
				{
					"simulationKey": "Warn users about potential alarm failures when the app is manually killed.",
					"simStepId": "727dfc15-97bd-4056-a1a8-c04394522595"
				}
			]
		},
		"76e00640-530a-4973-a136-194a6a21ba94": {
			"path": "76e00640-530a-4973-a136-194a6a21ba94",
			"cellName": "Register Termination Observer - AppTerminateManager.swift:L23-31",
			"cellId": "76e00640-530a-4973-a136-194a6a21ba94",
			"visible": true,
			"parentCellId": "595fc0dd-7912-4d0a-bd6b-86f2407a487a"
		},
		"ios/Classes/services/AppTerminateManager.swift-simstep-17f0778a-a19a-426f-b6a9-983ff13ce53f": {
			"path": "ios/Classes/services/AppTerminateManager.swift-simstep-17f0778a-a19a-426f-b6a9-983ff13ce53f",
			"fileName": "AppTerminateManager.swift",
			"wiki": "The `AppTerminateManager`'s `startMonitoring` method registers an observer with the system's `NotificationCenter`. This observer listens for the `UIApplication.willTerminateNotification` and will trigger the `appWillTerminate` method when the event occurs.",
			"cellName": "Register Termination Observer - AppTerminateManager.swift:L23-31",
			"cellId": "76e00640-530a-4973-a136-194a6a21ba94",
			"visible": true,
			"startLine": 23,
			"endLine": 31,
			"parentCellId": "595fc0dd-7912-4d0a-bd6b-86f2407a487a",
			"parentPath": "ios/Classes/services/AppTerminateManager.swift",
			"simSteps": [
				{
					"simulationKey": "Warn users about potential alarm failures when the app is manually killed.",
					"simStepId": "17f0778a-a19a-426f-b6a9-983ff13ce53f"
				}
			]
		},
		"1b34c09d-41b4-4ae6-84b4-c3203f8e11b0": {
			"path": "1b34c09d-41b4-4ae6-84b4-c3203f8e11b0",
			"cellName": "Handle App Termination Event - AppTerminateManager.swift:L47-52",
			"cellId": "1b34c09d-41b4-4ae6-84b4-c3203f8e11b0",
			"visible": true,
			"parentCellId": "595fc0dd-7912-4d0a-bd6b-86f2407a487a"
		},
		"ios/Classes/services/AppTerminateManager.swift-simstep-89cfe88d-6df3-4f69-8383-60758ffd6af7": {
			"path": "ios/Classes/services/AppTerminateManager.swift-simstep-89cfe88d-6df3-4f69-8383-60758ffd6af7",
			"fileName": "AppTerminateManager.swift",
			"wiki": "The `appWillTerminate` method in `AppTerminateManager` is executed in response to the system notification. It creates a task to call the `sendWarningNotification` function, ensuring the warning is sent before the app fully terminates.",
			"cellName": "Handle App Termination Event - AppTerminateManager.swift:L47-52",
			"cellId": "1b34c09d-41b4-4ae6-84b4-c3203f8e11b0",
			"visible": true,
			"startLine": 47,
			"endLine": 52,
			"parentCellId": "595fc0dd-7912-4d0a-bd6b-86f2407a487a",
			"parentPath": "ios/Classes/services/AppTerminateManager.swift",
			"simSteps": [
				{
					"simulationKey": "Warn users about potential alarm failures when the app is manually killed.",
					"simStepId": "89cfe88d-6df3-4f69-8383-60758ffd6af7"
				}
			]
		},
		"89644ff7-ce01-4dc5-8580-42708cc900c7": {
			"path": "89644ff7-ce01-4dc5-8580-42708cc900c7",
			"cellName": "Schedule Warning Notification with OS - AppTerminateManager.swift:L54-58",
			"cellId": "89644ff7-ce01-4dc5-8580-42708cc900c7",
			"visible": true,
			"parentCellId": "595fc0dd-7912-4d0a-bd6b-86f2407a487a"
		},
		"ios/Classes/services/AppTerminateManager.swift-simstep-7caf5638-3c45-4045-aac7-31b4c6235c9b": {
			"path": "ios/Classes/services/AppTerminateManager.swift-simstep-7caf5638-3c45-4045-aac7-31b4c6235c9b",
			"fileName": "AppTerminateManager.swift",
			"wiki": "The `sendWarningNotification` function assembles the notification's title and body (using defaults if not customized) and then calls the `NotificationManager` to schedule a local notification with the iOS UserNotifications framework. This notification informs the user that their alarms may not ring because the app was closed.",
			"cellName": "Schedule Warning Notification with OS - AppTerminateManager.swift:L54-58",
			"cellId": "89644ff7-ce01-4dc5-8580-42708cc900c7",
			"visible": true,
			"startLine": 54,
			"endLine": 58,
			"parentCellId": "595fc0dd-7912-4d0a-bd6b-86f2407a487a",
			"parentPath": "ios/Classes/services/AppTerminateManager.swift",
			"simSteps": [
