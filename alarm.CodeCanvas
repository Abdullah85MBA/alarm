		"android/src/main/kotlin/com/gdelataillade/alarm/alarm/AlarmService.kt-simstep-65d4b3d4-05bb-4ef4-b5f0-1a508cc133df": {
			"path": "android/src/main/kotlin/com/gdelataillade/alarm/alarm/AlarmService.kt-simstep-65d4b3d4-05bb-4ef4-b5f0-1a508cc133df",
			"fileName": "AlarmService.kt",
			"wiki": "When the alarm time is reached, Android's `AlarmManager` starts the `AlarmService`. This service retrieves the `AlarmSettings`, sets the initial system volume if required, and then delegates audio playback and fading to the `AudioService`.",
			"cellName": "Android Flow: Alarm Triggered - AlarmService.kt:L161-167",
