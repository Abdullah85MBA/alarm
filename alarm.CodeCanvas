					},
					"inputDataExample": "{\n  \"id\": 42,\n  \"millisecondsSinceEpoch\": 1725175800000,\n  \"assetAudioPath\": \"assets/marimba.mp3\",\n  \"loopAudio\": true,\n  \"vibrate\": true,\n  \"warningNotificationOnKill\": true,\n  \"androidFullScreenIntent\": true,\n  \"allowAlarmOverlap\": false,\n  \"iOSBackgroundAudio\": true,\n  \"androidStopAlarmOnTermination\": true,\n  \"notificationSettings\": {\n    \"title\": \"Alarm\",\n    \"body\": \"Wake up!\"\n  },\n  \"volumeSettings\": {\n    \"volume\": 0.8\n  }\n}",
					"outputDataExample": "{\n  \"id\": 42,\n  \"millisecondsSinceEpoch\": 1725175800000,\n  \"assetAudioPath\": \"assets/marimba.mp3\",\n  \"loopAudio\": true,\n  \"vibrate\": true,\n  \"warningNotificationOnKill\": true,\n  \"androidFullScreenIntent\": true,\n  \"allowAlarmOverlap\": false,\n  \"iOSBackgroundAudio\": true,\n  \"androidStopAlarmOnTermination\": true,\n  \"notificationSettings\": {\n    \"title\": \"Alarm\",\n    \"body\": \"Wake up!\"\n  },\n  \"volumeSettings\": {\n    \"volume\": 0.8\n  }\n}"
				},
				{
					"simStepId": "727dfc15-97bd-4056-a1a8-c04394522595",
					"diagramNodeId": "bb829b54-5dbe-40e5-b7d7-b5880b0d414e",
					"simStepLabel": "Start App Termination Monitoring",
					"simStepDescription": "The native `AlarmManager` receives the alarm settings. Its `updateState` method checks if any scheduled alarm has `warningNotificationOnKill` enabled. If so, it calls `AppTerminateManager` to start monitoring for app termination events.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "ios/Classes/services/AlarmManager.swift",
						"startLine": "232",
						"endLine": "234",
						"relevantVariables": [
							"updateState()",
							"warningNotificationOnKill",
							"AppTerminateManager.shared.startMonitoring()"
						]
					},
					"inputDataExample": "{\n  \"id\": 42,\n  \"millisecondsSinceEpoch\": 1725175800000,\n  \"assetAudioPath\": \"assets/marimba.mp3\",\n  \"loopAudio\": true,\n  \"vibrate\": true,\n  \"warningNotificationOnKill\": true,\n  \"androidFullScreenIntent\": true,\n  \"allowAlarmOverlap\": false,\n  \"iOSBackgroundAudio\": true,\n  \"androidStopAlarmOnTermination\": true,\n  \"notificationSettings\": {\n    \"title\": \"Alarm\",\n    \"body\": \"Wake up!\"\n  },\n  \"volumeSettings\": {\n    \"volume\": 0.8\n  }\n}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "2a634b0a-1d6b-4535-86f6-364fe4b2c689",
					"diagramNodeId": "be4d5947-5ff3-4c37-bbee-ac14bf849692",
					"simStepLabel": "Invoke Termination Monitor",
					"simStepDescription": "A direct method call is made from `AlarmManager` to the shared instance of `AppTerminateManager` to begin observing for the app termination event.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "ios/Classes/services/AlarmManager.swift",
						"startLine": "233",
						"endLine": "233",
						"relevantVariables": [
							"AppTerminateManager.shared.startMonitoring()"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "17f0778a-a19a-426f-b6a9-983ff13ce53f",
					"diagramNodeId": "76e00640-530a-4973-a136-194a6a21ba94",
					"simStepLabel": "Register Termination Observer",
					"simStepDescription": "The `AppTerminateManager`'s `startMonitoring` method registers an observer with the system's `NotificationCenter`. This observer listens for the `UIApplication.willTerminateNotification` and will trigger the `appWillTerminate` method when the event occurs.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "ios/Classes/services/AppTerminateManager.swift",
						"startLine": "23",
						"endLine": "31",
						"relevantVariables": [
							"startMonitoring()",
							"NotificationCenter.default.addObserver",
							"UIApplication.willTerminateNotification",
							"appWillTerminate(notification:)"
						]
					},
