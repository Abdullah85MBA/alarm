		"lib/alarm.dart-simstep-8e20b178-b842-4d2f-a5f7-9601cd6bb79c": {
			"path": "lib/alarm.dart-simstep-8e20b178-b842-4d2f-a5f7-9601cd6bb79c",
			"fileName": "alarm.dart",
			"wiki": "The button's `onPressed` callback invokes `Alarm.stop(id)`, passing the unique ID of the alarm to be stopped. This method orchestrates both the native platform call and the subsequent state update in Dart.",
			"cellName": "Alarm Stopping: Call `Alarm.stop` - alarm.dart:L152-167",
			"cellId": "b1e15799-60aa-4bc0-807f-427f1e87c227",
			"visible": true,
			"startLine": 152,
			"endLine": 167,
			"parentCellId": "4e0798c7-e641-49c0-a5a6-1e52a1aade60",
			"parentPath": "lib/alarm.dart",
			"simSteps": [
				{
					"simulationKey": "Allow the app to react in real-time to alarm events like ringing or being stopped.",
					"simStepId": "8e20b178-b842-4d2f-a5f7-9601cd6bb79c"
				}
			]
		},
		"b9f022cf-8234-4948-beab-49f4560330a9": {
			"path": "b9f022cf-8234-4948-beab-49f4560330a9",
			"cellName": "Alarm Stopping: Native Code Stops Service - AlarmApiImpl.kt:L39-44",
			"cellId": "b9f022cf-8234-4948-beab-49f4560330a9",
			"visible": true,
			"parentCellId": "432e2862-3019-4964-9863-443e9460c5f0"
